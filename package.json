{
  "name": "remix-ludo-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:worker": "wrangler dev --config wrangler.toml --port 8787",
    "deploy:worker": "npm run build && wrangler deploy --config wrangler.toml",
    "deploy:staging": "npm run build && wrangler deploy --config wrangler.toml --env staging",
    "deploy:production": "npm run build && wrangler deploy --config wrangler.toml --env production",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate:staging": "node scripts/migrate.js staging",
    "db:migrate:production": "node scripts/migrate.js production",
    "db:backup:staging": "node scripts/backup.js staging",
    "db:backup:production": "node scripts/backup.js production"
  },
  "dependencies": {
    "@cloudflare/realtimekit": "^2.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
